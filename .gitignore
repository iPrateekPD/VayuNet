# =========================================================
# VAYUNET — Root .gitignore
# =========================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js / Frontend Dependencies & Bundles
node_modules/
dashboard/node_modules/
dist/
dashboard/dist/
build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env.local
.env.*.local
dashboard/.env.local
dashboard/.env.*.local

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*~

# Model Checkpoints & Large Data (Preserve Directory Structure with .gitkeep)
checkpoints/*
!checkpoints/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/interim/*
!backend/data/interim/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep

# Temporary Artifacts
*.tmp
*.log

# Datasets & Large Files
datasets/
*.csv
*.tsv
*.nc
*.tif
*.tiff
*.h5
*.hdf5
*.pt
*.pth
*.safetensors
*.pkl
*.db
*.sqlite
*.npy
*.npz

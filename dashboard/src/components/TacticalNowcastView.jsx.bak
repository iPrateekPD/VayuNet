import React, { useState, useEffect, useRef } from 'react';
import { getLocations, getLocationNowcast } from '../services/apiService';
import { MapContainer, TileLayer, Polygon, Marker, useMap, Polyline, Rectangle } from 'react-leaflet';
import L from 'leaflet';
import 'leaflet/dist/leaflet.css';
import { getNowcastState } from '../data/nowcastMockData';
import { SHARED_EVENTS } from '../data/sharedEventData';
import OperationalMap from './OperationalMap';
import AIRiskAssessmentPanel from './AIRiskAssessmentPanel';
import './TacticalNowcast.css';

// (Map logic moved to OperationalMap.jsx)
const TIME_STEPS = ['Now', '+1h', '+2h', '+3h', '+4h', '+5h', '+6h'];
export default function TacticalNowcastView({ showToast, onNavigateTab, globalSelectedLocation, setGlobalSelectedLocation }) {
  // Try to resolve globalSelectedLocation if it's an Event ID
  const eventMatch = SHARED_EVENTS.find(e => e.id === globalSelectedLocation);
  const resolvedLocation = eventMatch ? eventMatch.location : globalSelectedLocation;

  const selectedSector = resolvedLocation || 'Chamoli, Uttarakhand';
  const setSelectedSector = setGlobalSelectedLocation || (() => {});
  const [sectorCoords, setSectorCoords] = useState({ 'Chamoli, Uttarakhand': [30.41, 79.32] });
  const [sectorOptions, setSectorOptions] = useState(['Chamoli, Uttarakhand']);
  const [sectorIdMap, setSectorIdMap] = useState({ 'Chamoli, Uttarakhand': 'chamoli' });

  useEffect(() => {
    async function loadLocations() {
      const data = await getLocations();
      if (data && data.locations) {
        const coords = {};
        const options = [];
        const idMap = {};
        data.locations.forEach(loc => {
          const displayName = `${loc.name}, ${loc.state}`;
          coords[displayName] = [loc.lat, loc.lng];
          options.push(displayName);
          idMap[displayName] = loc.id;
        });
        setSectorCoords(coords);
        setSectorOptions(options);
        setSectorIdMap(idMap);
      }
    }
    loadLocations();
  }, []);

  const [selectedStep, setSelectedStep] = useState('+2h');
  const [isPlaying, setIsPlaying] = useState(false);
  const [isSectorOpen, setIsSectorOpen] = useState(false);
  
  // Hazard Layers
  const [activeHazard, setActiveHazard] = useState('COMPOSITE'); // COMPOSITE, THUNDERSTORM, CLOUDBURST, FLASH FLOOD, PRECIPITATION
  const [selectedIncident, setSelectedIncident] = useState(null);
  
  const mapCardRef = useRef(null);
  const mapRef = useRef(null);
  const defaultCenter = sectorCoords[selectedSector] || [30.41, 79.32];
  const [currentCenter, setCurrentCenter] = useState(defaultCenter);

  // Normalized Mock API State
  const [nowcastState, setNowcastState] = useState(null);

  useEffect(() => {
    // Determine bounds for grid generation
    // If map isn't ready, use a default bounds box around the defaultCenter
    let bounds = null;
    if (mapRef.current) {
      bounds = mapRef.current.getBounds();
    } else {
      const p = 0.5; // roughly half degree
      bounds = L.latLngBounds([defaultCenter[0] - p, defaultCenter[1] - p], [defaultCenter[0] + p, defaultCenter[1] + p]);
    }
    
    // Call the mock data layer
    const state = getNowcastState(activeHazard, selectedStep, bounds);
    setNowcastState(state);
  }, [activeHazard, selectedStep, defaultCenter]);

  // Fallback to active forecast if incident is unselected
  const activeIncident = selectedIncident || (nowcastState ? nowcastState.activeForecasts[0] : null);
  const [currentZoom, setCurrentZoom] = useState(9);

  const [layerOpacity, setLayerOpacity] = useState(65);
  const [aiPredictions, setAiPredictions] = useState(null);
  const [currentTime, setCurrentTime] = useState(new Date());

  useEffect(() => {
    const timer = setInterval(() => setCurrentTime(new Date()), 1000);
    return () => clearInterval(timer);
  }, []);

  const liveDateFormatted = currentTime.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  const liveTimeFormatted = currentTime.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }) + ' IST';

  // Simulation Playback Loop (Now → +6h)
  useEffect(() => {
    let timer;
    if (isPlaying) {
      timer = setInterval(() => {
        setSelectedStep((prev) => {
          const idx = TIME_STEPS.indexOf(prev);
          const nextIdx = (idx + 1) % TIME_STEPS.length;
          return TIME_STEPS[nextIdx];
        });
      }, 1500);
    }
    return () => clearInterval(timer);
  }, [isPlaying]);

  // AI Prediction Fetch
  useEffect(() => {
    let leadTime = 0;
    if (selectedStep.includes('1h')) leadTime = 1;
    else if (selectedStep.includes('2h')) leadTime = 2;
    else if (selectedStep.includes('3h')) leadTime = 3;
    else if (selectedStep.includes('4h')) leadTime = 4;
    else if (selectedStep.includes('5h')) leadTime = 5;
    else if (selectedStep.includes('6h')) leadTime = 6;

    const fetchPrediction = async () => {
      try {
        const locId = sectorIdMap[selectedSector] || selectedSector.split(',')[0].toLowerCase().trim();
        const data = await getLocationNowcast(locId, leadTime);
        if (data) {
          setAiPredictions(data);
        }
      } catch (e) {
        console.error("AI inference error", e);
      }
    };
    fetchPrediction();
  }, [selectedSector, selectedStep, sectorIdMap]);

  const handleTogglePlay = () => {
    setIsPlaying((prev) => {
      const next = !prev;
      if (showToast) showToast(next ? 'Forecast simulation playback started' : 'Forecast simulation paused');
      return next;
    });
  };

  const handleSelectIncident = (inc) => {
    setSelectedIncident(inc);
    setSelectedSector(inc.name);
    setCurrentCenter([...inc.center]);
    setCurrentZoom(9.5);
    if (showToast) showToast(`Centered on ${inc.name} (${inc.hazard})`);
  };

  const handleRecenter = () => {
    setCurrentCenter([...(sectorCoords[selectedSector] || [30.41, 79.32])]);
    setCurrentZoom(9);
    if (showToast) showToast(`Recentered to ${selectedSector}`);
  };

  const handleToggleFullscreen = () => {
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else if (mapCardRef.current) {
      mapCardRef.current.requestFullscreen();
    }
  };

  return (
    <div className="tac-app-shell">
      {/* 1. FULL WIDTH FORECAST / LOCATION CONTROL BAR */}
      <div className="tac-top-control-bar">
        {/* Left: Location & Status */}
        <div className="tac-tcb-left">
          <div className="tac-clean-sector-wrap">
            <button type="button" className="tac-clean-sector-btn" onClick={() => setIsSectorOpen(!isSectorOpen)}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" strokeWidth="2.2">
                <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
              <span>{selectedSector}</span>
              <span style={{ fontSize: '10px', marginLeft: '4px', opacity: 0.7 }}>▾</span>
            </button>
            {isSectorOpen && (
              <div className="tac-clean-sector-menu">
                {sectorOptions.map((opt) => (
                  <div
                    key={opt}
                    className={`tac-clean-sector-option ${selectedSector === opt ? 'active' : ''}`}
                    onClick={() => {
                      setSelectedSector(opt);
                      setIsSectorOpen(false);
                      if (sectorCoords[opt]) {
                        setCurrentCenter([...sectorCoords[opt]]);
                        setCurrentZoom(9);
                      }
                      if (showToast) showToast(`Centered to ${opt}`);
                    }}
                  >
                    {opt}
                  </div>
                ))}
              </div>
            )}
          </div>
          
          <div className="tac-clean-live-pill">
            <span className="tac-live-date-text">{liveDateFormatted}, </span>
            <span className="tac-live-time-text">{liveTimeFormatted}</span>
            <span className="tac-clean-live-dot" />
            <span style={{ color: '#22c55e', fontWeight: 700 }}>Live Sync</span>
          </div>
        </div>

        {/* Center: Search */}
        <div className="tac-tcb-center">
          <div className="tac-global-search" style={{ flex: '0 1 300px' }}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="tac-search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" placeholder="Search locations..." style={{ fontSize: '13px', padding: '6px 12px 6px 36px', height: '32px' }} />
          </div>
        </div>

        {/* Right: Forecast Timeline */}
        <div className="tac-tcb-right">
          <div className="tac-clean-timesteps-group">
            <button
              type="button"
              className={`tac-clean-forecast-play-btn ${isPlaying ? 'playing' : ''}`}
              onClick={handleTogglePlay}
              title="Play/Pause 6-Hour Forecast Simulation"
            >
              {isPlaying ? (
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                  <rect x="6" y="4" width="4" height="16" rx="1" />
                  <rect x="14" y="4" width="4" height="16" rx="1" />
                </svg>
              ) : (
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="6 4 19 12 6 20 6 4" />
                </svg>
              )}
              <span>{isPlaying ? 'Pause' : 'Play'}</span>
            </button>

            {TIME_STEPS.map((step) => (
              <button
                key={step}
                type="button"
                className={`tac-clean-time-pill ${selectedStep === step ? 'active' : ''}`}
                onClick={() => setSelectedStep(step)}
              >
                {step}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="tac-operational-body">
        <div className="tac-clean-grid">
          {/* ================= LEFT/CENTER COLUMN: MAP ================= */}
          <div className="tac-clean-col-left" ref={mapCardRef}>
            <OperationalMap 
              mode="nowcast"
              eventData={{ id: selectedSector, location: selectedSector, coords: currentCenter }}
              nowcastState={nowcastState}
              activeHazard={activeHazard}
              setActiveHazard={setActiveHazard}
              selectedStep={selectedStep}
              setSelectedStep={setSelectedStep}
              onMapMoveEnd={(map) => {
                const state = getNowcastState(activeHazard, selectedStep, map.getBounds());
                setNowcastState(state);
              }}
              onToggleFullscreen={handleToggleFullscreen}
            />
          </div>

          {/* ================= RIGHT COLUMN: THREAT SUMMARY ================= */}
          <div className="tac-clean-col-right">
            <AIRiskAssessmentPanel 
              predictions={aiPredictions} 
              nowcastState={nowcastState}
              selectedIncident={activeIncident}
              onSelectIncident={handleSelectIncident}
            />
          </div>
        </div>
      </div>
    </div>
  );
}
